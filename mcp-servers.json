{
  "scope": "user",
  "servers": {
    "context7": {
      "headers": {
        "CONTEXT7_API_KEY": "<REDACTED>"
      },
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    },
    "playwright": {
      "args": [
        "@playwright/mcp@latest"
      ],
      "command": "npx"
    },
    "safari-mcp-stp": {
      "args": [
        "--mcp"
      ],
      "command": "/Applications/Safari Technology Preview.app/Contents/MacOS/safaridriver"
    }
  },
  "version": 2
}
